# Copiar a .env antes de arrancar el gateway fuera de Docker:
#   cp .env.example .env
#
# Dentro de docker-compose.yml esta variable la fija el propio compose
# (GATEWAY_BACKEND_URL: http://api:8000); este fichero es solo para cuando se
# arranca el gateway suelto, con `uv run uvicorn app.main:app`.

# Opcional. URL base del backend al que reenvia el gateway por HTTP.
# Por defecto: http://localhost:8000
# GATEWAY_BACKEND_URL=http://localhost:8000
