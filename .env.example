# Variables para Docker Compose. Copiar a .env EN LA RAIZ del repo:
#   cp .env.example .env
#
# Compose lee el .env que esta junto a docker-compose.yml, NO backend/.env.
# backend/.env solo lo lee el backend cuando se lanza fuera de Docker (uv run).
# Si una variable falta aqui, Compose la sustituye por una cadena vacia y solo
# avisa con un warning: la API arranca, pero sin clave el LLM falla al preguntar.
#
# Ademas de este fichero, Compose acepta las variables exportadas en la shell
# (APP_GEMINI_API_KEY=... docker compose up), que tienen prioridad sobre .env.

# Obligatoria: API key de Google AI Studio para Gemini (via LiteLLM).
APP_GEMINI_API_KEY=

# Opcional: carpeta del host con los modelos (fastembed, tokenizer y Docling),
# montada en /models en api y worker. Por defecto, la misma que usa el backend
# fuera de Docker, para que haya una sola copia en disco.
# AGENT4U_MODELOS=~/.cache/agent4u/modelos
