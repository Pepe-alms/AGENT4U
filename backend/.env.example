# Copiar a .env antes de arrancar la app o lanzar los tests:
#   cp .env.example .env
#
# Obligatoria: sin esta variable Settings falla al construirse y ni siquiera
# se recolectan los tests. Para la suite basta con un valor cualquiera, porque
# el LLM esta doblado; para levantar la app hace falta la clave real.
GEMINI_API_KEY=

# Opcionales: si se omiten se usan los valores por defecto de app/core/config.py
# APP_QDRANT_URL=http://localhost:6333
# APP_QDRANT_COLLECTION=Agent4U
# APP_LLM_MODEL=gemini/gemini-flash-lite-latest
# APP_DB_URL=sqlite:///./agent4u.db

# Carpeta donde POST /indexar-fichero guarda lo que sube el cliente.
# APP_UPLOAD_DIR=./uploads
# Techo por fichero, en bytes. Por defecto 50 MB.
# APP_UPLOAD_MAX_BYTES=52428800

# Modelos que el cliente puede pedir en POST /preguntar, separados por comas.
# El de APP_LLM_MODEL siempre entra, aunque no este en la lista.
# APP_LLM_MODELOS=gemini/gemini-flash-lite-latest,gemini/gemini-flash-latest
# Fragmentos que se pasan al modelo tras reordenar, y su tope.
# APP_MAX_FRAGMENTOS_DEFECTO=10
# APP_MAX_FRAGMENTOS_TOPE=20
