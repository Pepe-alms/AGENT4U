# Copiar a .env antes de arrancar la app o lanzar los tests:
#   cp .env.example .env
#
# Obligatoria: sin esta variable Settings falla al construirse y ni siquiera
# se recolectan los tests. Para la suite basta con un valor cualquiera, porque
# el LLM esta doblado; para levantar la app hace falta la clave real.
APP_GEMINI_API_KEY=

# Opcionales: si se omiten se usan los valores por defecto de app/core/config.py
# APP_QDRANT_URL=http://localhost:6333
# APP_QDRANT_COLLECTION=Agent4U
# APP_LLM_MODEL=gemini/gemini-flash-lite-latest
# APP_DB_URL=sqlite:///./agent4u.db

# Carpeta donde POST /indexar-fichero guarda lo que sube el cliente.
# APP_UPLOAD_DIR=./uploads
# Techo por fichero, en bytes. Por defecto 50 MB.
# APP_UPLOAD_MAX_BYTES=52428800

# --- Modelos ---
# Los leen la API (consulta) y el worker (indexacion), y los dos tienen que
# ver los mismos valores. Con Docker Compose este fichero no entra en la
# imagen: habria que ponerlos en el bloque `environment` de api y de worker.
# Cambiar el denso, su dimension o el disperso obliga a
# reindexar; la dimension solo se aplica al crear la coleccion.
# APP_MODELO_DENSO=intfloat/multilingual-e5-large
# APP_DIMENSION_DENSA=1024
# APP_MODELO_DISPERSO=Qdrant/bm25
# APP_IDIOMA_DISPERSO=spanish
# APP_MODELO_RERANKER=jinaai/jina-reranker-v2-base-multilingual
# Techo de tokens por fragmento, con el tokenizer del modelo denso.
# APP_CHUNK_MAX_TOKENS=500
# Carpeta donde se descargan los modelos (fastembed, tokenizer y Docling).
# Docker Compose monta esta misma carpeta en /models: una sola copia en disco.
# APP_MODELOS_DIR=~/.cache/agent4u/modelos

# --- Redis ---
# URL del broker para la cola de trabajos (ARQ).
# APP_REDIS_URL=redis://localhost:6379

# --- Indexacion ---
# Cuantas indexaciones corren A LA VEZ. Uno por defecto, y no es timidez:
# Docling y ONNX ya usan todos los nucleos por su cuenta, asi que dos
# simultaneas no van a la mitad de velocidad cada una, van peor.
# APP_INDEX_MAX_CONCURRENTES=1
# Cuantas pueden ESPERAR turno en la cola de Redis. Pasado
# concurrentes + en_cola se responde 429 con Retry-After.
# APP_INDEX_MAX_EN_COLA=4
# Puntos por `upsert` contra Qdrant. Subirlos todos de golpe mantiene en
# memoria el documento entero vectorizado.
# APP_INDEX_LOTE_UPSERT=200

# Modelos que el cliente puede pedir en POST /preguntar, separados por comas.
# El de APP_LLM_MODEL siempre entra, aunque no este en la lista.
# APP_LLM_MODELOS=gemini/gemini-flash-lite-latest,gemini/gemini-flash-latest
# Fragmentos que se pasan al modelo tras reordenar, y su tope.
# APP_MAX_FRAGMENTOS_DEFECTO=10
# APP_MAX_FRAGMENTOS_TOPE=20
